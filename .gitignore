# 模型权重（大文件）
*.pt

# 视频文件
*.mp4
*.avi

# 生成输出（运行时产物）
outputs/
runs/

# 根目录遗留的评测图表 / JSON
*.png
*.json
# 标定数据目录例外（纳入版本管理）
!calibrations/**/*.json

# Python 缓存
__pycache__/
*.pyc
*.pyo
*.pyd

# macOS
.DS_Store

# 数据目录（含视频符号链接）
data/

# 比赛文档（含敏感信息，不纳入版本管理）
docs/

# Claude Code / IDE 内部文件
.superpowers/
.idea/
.claude/

# 调试输出
debug_diag/

# 压缩备份
*.zip

# 字体
*.ttf

# 过程文档
PROGRESS.md
findings.md
task_plan.md

# 调试/训练脚本（不纳入版本管理）
test_*.py
train_*.py
